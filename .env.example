# Environment: development | test | production
NODE_ENV=development
PORT=3000

# Database Provider: sqlite (lokal/uji coba) | postgres (produksi VPS)
DB_PROVIDER=sqlite
SQLITE_PATH=./data/dev.sqlite
DATABASE_URL=postgres://kemitir:secretpassword@localhost:5432/bekemitir

# Security & Auth (Minimal 32 karakter acak untuk HMAC-SHA256)
JWT_SECRET=ganti_dengan_minimal_32_karakter_acak_kriptografis_aman
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_GRACE_WINDOW_SECONDS=15
TRUST_PROXY=false

# CORS Allowlist (dipisahkan koma, tanpa wildcard '*' jika menggunakan credentials)
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# Cloudflare R2 Storage (Opsional saat dev lokal; wajib diisi di produksi VPS)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=kemitir-gis
R2_PUBLIC_URL=https://tiles.kemitir.example.com
LOCAL_UPLOAD_DIR=./uploads
